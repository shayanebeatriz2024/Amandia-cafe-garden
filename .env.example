# URL pública canônica (sem barra final)
NEXT_PUBLIC_SITE_URL=https://www.amandiacafegarden.com.br

# Google Analytics 4 — ID de medição (OBRIGATÓRIA para registrar visitas)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console (opcional) — conteúdo da meta tag de verificação
NEXT_PUBLIC_GSC_VERIFICATION=

# Supabase (OBRIGATÓRIAS) — leitura pública sob RLS. Supabase → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role (somente servidor — NUNCA use NEXT_PUBLIC_). Usada só para os currículos:
# grava as candidaturas (/api/candidaturas) e lista na pastinha do /admin. Supabase → Settings → API.
SUPABASE_SERVICE_ROLE_KEY=

# Segredo do webhook de revalidação (somente servidor) — gere com: openssl rand -hex 32
REVALIDATE_SECRET=

# ── Painel /admin (OBRIGATÓRIAS para entrar no painel) ────────────────────────
# Login por e-mail + senha, conferido só no servidor. Trocar qualquer um desconecta todas as sessões.
# Em produção use uma senha longa e única (12+ caracteres). Nunca use o prefixo NEXT_PUBLIC_.
ADMIN_EMAIL=admin@seudominio.com.br
ADMIN_PASSWORD=

# GA4 Data API — OBRIGATÓRIAS para as métricas reais do painel (somente servidor — NUNCA use o prefixo NEXT_PUBLIC_ nestas variáveis)
# ID numérico da propriedade (GA4 → Administrador → Detalhes da propriedade), ex.: 123456789
GA_PROPERTY_ID=
# Do JSON da Service Account: campo "client_email"
GOOGLE_CLIENT_EMAIL=
# Do JSON da Service Account: campo "private_key", entre aspas e com os \n literais
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
