# URL pública canônica (sem barra final)
NEXT_PUBLIC_SITE_URL=https://www.amandiacafegarden.com.br

# Google Analytics 4 — ID de medição
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Google Search Console (opcional) — conteúdo da meta tag de verificação
NEXT_PUBLIC_GSC_VERIFICATION=

# Supabase (leitura pública sob RLS)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Segredo do webhook de revalidação (somente servidor) — gere com: openssl rand -hex 32
REVALIDATE_SECRET=

# ── Painel /admin ─────────────────────────────────────────────────────────────
# Senha de acesso ao painel (somente servidor). Use uma senha longa; trocá-la desconecta todas as sessões.
ADMIN_PASSWORD=

# GA4 Data API (somente servidor — NUNCA use o prefixo NEXT_PUBLIC_ nestas variáveis)
# ID numérico da propriedade (GA4 → Administrador → Detalhes da propriedade), ex.: 123456789
GA_PROPERTY_ID=
# Do JSON da Service Account: campo "client_email"
GOOGLE_CLIENT_EMAIL=
# Do JSON da Service Account: campo "private_key", entre aspas e com os \n literais
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
